{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git branch:*)", "Bash(git add:*)", "Bash(git checkout:*)",
      "Bash(git switch:*)", "Bash(git commit:*)", "Bash(git fetch:*)",
      "Bash(git pull:*)", "Bash(git merge:*)", "Bash(git push:*)",
      "Bash(npm test:*)", "Bash(npm run:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git reset --hard:*)", "Bash(git filter-branch:*)"
    ]
  }
}
